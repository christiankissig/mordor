x := 0;
y := 0;
{
   x := 2;
   r1 := x;
   if (r1 != 2) {
     y := 1;
   }
} ||| {
  x := 1;
  r2 := x;
  r3 := y;
  if(r3 != 0) {
    x := 3
  }
}
%%
// S. Chakraborty and V. Vafeiadis, "Grounding Thin-Air Reads with Event Structures", POPL 2019, Example 2
// and Fig. 5a, reach this outcome (the program is their Fig. 3), but under their simplified presentation of
// PS, which certifies promises against the current memory only. Their witness certifies T1's promise of
// y := 1 by writing x := 2 into the gap below T2's x := 1. PS1.0 certifies against every future memory, and
// one that fills the gap blocks this; PS2.0's capped memory reserves the gap. Both forbid the outcome (#138).
forbid (r1 = 3 && r2 = 2 && r3 = 1) [PS1] "Edge case."