// Section 4.1: Release/Acquire Synchronization; Page 7, Column 1 (b)
x := 0;
y := 0;
{
  x := 1;
  y.store(1, rel);
  y := 2
} ||| {
  rpy := &y;
  r1 := FADD(rlx, rlx, rpy, 1)
} ||| {
  r2 := y.load(acq); // 3
  r3 := x // <> 0
}
%%
// Forbidden under promising semantics 1.0: Kang et al., POPL 2017, §4.1 "Release Sequences" -- the acquire
// read synchronises with y.store(1, rel) through the FADD, so the third thread must read x = 1.
forbid (r2 = 3 && r3 = 0) [PS1] "Release sequence"
