// Expected verdict from M. Batty, K. Memarian, K. Nienhuis, J. Pichon-Pharabod and P. Sewell, "The Problem of Programming Language Concurrency Semantics", ESOP 2015; checked here under sMRD.
x := 0;
y := 0;
{
  r1 := x;
  if (r1 = 1) {
    r2 := x;
    y := r2
  } else {
    y := 1
  }
} ||| {
  r3 := y;
  x := r3
}
%%
allow (r1 = 1 && r3 = 1) [sMRD]