// Expected verdict from A. Jeffrey and J. Riely, "On Thin Air Reads: Towards an Event Structures Model of Relaxed Memory", LMCS 15(1), 2019; checked here under sMRD.
x := 0;
y := 0;
z := 0;
{ r1 := x;
  y := r1
} ||| {
  r2 := y;
  if(r2 = 0) {
    r3 := y;
    x := r3
  }
  else
  {
    x := 1
  }
}
%%
forbid (r2 = 1) [sMRD]