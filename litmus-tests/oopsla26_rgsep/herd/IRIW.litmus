C IRIW
{ [x] = 0; [y] = 0; }
P0 (atomic_int* x) { atomic_store_explicit(x, 1, memory_order_release); }
P1 (atomic_int* x, atomic_int* y) { int a = atomic_load_explicit(x, memory_order_acquire); int b = atomic_load_explicit(y, memory_order_acquire); }
P2 (atomic_int* x, atomic_int* y) { int c = atomic_load_explicit(y, memory_order_acquire); int d = atomic_load_explicit(x, memory_order_acquire); }
P3 (atomic_int* y) { atomic_store_explicit(y, 1, memory_order_release); }
exists (1:a=1 /\ 1:b=0 /\ 2:c=1 /\ 2:d=0)
