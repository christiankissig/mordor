{ [x] = 0; [y] = 0; [z] = 0; }
P0 (atomic_int* x, atomic_int* y) { atomic_store_explicit(x, 1, memory_order_relaxed); int a = atomic_load_explicit(x, memory_order_relaxed); atomic_store_explicit(y, a, memory_order_relaxed); }
P1 (atomic_int* x, atomic_int* z) { atomic_store_explicit(x, 2, memory_order_relaxed); int b = atomic_load_explicit(x, memory_order_relaxed); atomic_store_explicit(z, b, memory_order_relaxed); }
