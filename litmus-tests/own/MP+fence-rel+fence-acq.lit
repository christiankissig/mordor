// MP+fence-rel+fence-acq -- message passing through a release fence and an
// acquire fence over relaxed accesses.
//
// MoRDor's own test, for github #126. The flag write is relaxed but po-after a
// release fence, the flag read relaxed but po-before an acquire fence, so the
// fences synchronise (RC11's sw, [F_rel];po;[W];rf;[R];po;[F_acq]) and the data
// read must see the data write. sMRD's sw had only [W_rel];rf;[R_acq], so its
// hb ordered nothing across the threads and this outcome came out allowed.
x := 0;
y := 0;
{
  x.store(1, rlx);
  fence(rel);
  y.store(1, rlx)
} ||| {
  r1 := y.load(rlx);
  fence(acq);
  r2 := x.load(rlx)
}
%%
forbid (r1 = 1 && r2 = 0) [smrd]
forbid (r1 = 1 && r2 = 0) [rc11]
