// A relation membership under ! is decided like any other atom (#143).
//
// The execution that forwards x := 0 into r1 := x has no dependency (2,4),
// and the one that reads x := 0 has it. !((2,4) ∈ .dp) holds in the first,
// and (2,4) ∉ .dp with it. An assertion with a membership under ! used to
// stop with "Unsupported unary operator in".
x := 0;
r1 := x;
if (r1 = 0) {
  y := 1
}
%%
allow (!((2,4) ∈ .dp)) []
allow (!((2,4) ∉ .dp) && r1 = 0) []
