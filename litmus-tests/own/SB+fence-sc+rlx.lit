// SB+fence-sc+rlx -- store buffering with an sc fence in one thread only.
//
// MoRDor's own test, for github #126; the control for promising/SB+fences.
// psc orders sc fences against each other, and with one there is nothing to
// order it against: both loads may read 0.
x := 0; y := 0;
{
  x.store(1, rlx);
  fence(sc);
  r1 := y.load(rlx)
} ||| {
  y.store(1, rlx);
  r2 := x.load(rlx)
}
%%
allow (r1 = 0 && r2 = 0) [smrd]
allow (r1 = 0 && r2 = 0) [rc11]
