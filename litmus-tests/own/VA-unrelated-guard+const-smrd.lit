// Companion to VA-unrelated-guard-smrd.lit, writing the constant 1.
//
// Value assignment has nothing to rewrite here, so the guard on r2 was never
// discharged and sMRD forbade the outcome throughout. Keeping the pair adjacent
// makes the asymmetry visible if it returns.
x := 0;
y := 0;
z := 1;
{
  r1 := z;
  r2 := x;
  if (r1 = 1) {
    if (r2 > 0) {
      y := 1
    }
  }
} ||| {
  r3 := y;
  if (r3 > 0) {
    x := r3
  }
}
%%
forbid (r2 = 1 && r3 = 1) []
