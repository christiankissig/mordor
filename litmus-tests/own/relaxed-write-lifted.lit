// The control for volatile-write-not-lifted.lit: both arms of the branch write
// the same value to y, so lifting merges the two writes into one that no longer
// depends on the read of x.
//
// Without it, volatile-write-not-lifted.lit alone would also pass if lifting
// were disabled for everything rather than for volatile accesses.
//
// The read of x is volatile so that it cannot be forwarded from x := 0. A
// forwarded read drops its dependency too, and the assertion counts a
// forwarded read as executed, so forwarding would remove (3,5) from .dp
// without any lifting and the assertion would pass without showing that
// lifting works. A volatile read before the branch does not stop lifting.
x := 0;
y := 0;
r1 :v= x;
if (r1 = 0) {
  y := 1;
} else {
  y := 1;
}
%% allow ((3,5) ∉ .dp) []
