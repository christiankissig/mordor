// Read-read coherence where the reading thread has no write. RC11 orders the
// two reads by sb|loc and forbids r1 = 1 && r2 = 0. sMRD forbids it too,
// because MoRDor's ppo includes a thread's terminal events. A ppo that relates
// only events at or before a justified write of the thread would be empty on
// this reader, and coherence over ppo would then admit the outcome.
x := 0;
{
  x.store(1, rlx)
} ||| {
  r1 := x.load(rlx);
  r2 := x.load(rlx)
}
%%
forbid (r1 = 1 && r2 = 0) [RC11, sMRD]
