// A volatile read may not be lifted out of the branch that guards it.
//
// relaxed-read-lifted.lit is the same program with relaxed reads. Lifting the
// write of y out of the outer branch needs the relabelling that pairs the
// then-arm's read of y with the else-arm's, which hoists both reads with it.
// Volatile reads stay where the program put them, so the relabelling is
// refused, the write stays under the outer branch, and it keeps its
// dependency on the read of x.
//
// The writes are relaxed: this is the read side alone. A read before the
// branch, shared by both arms, would not be lifted, volatile or not.
//
// The read of x is volatile so that it cannot be forwarded from x := 0. A
// forwarded read drops its dependency too, and the assertion counts a
// forwarded read as executed, so forwarding would remove (3,7) from .dp
// without any lifting and the assertion could not tell the two apart. A
// volatile read before the branch does not stop lifting: the control
// relaxed-read-lifted.lit shows the dependency removed with the same read.
x := 0;
y := 0;
r1 :v= x;
if (r1 = 0) {
  r2 :v= y;
  if (r2 = 0) {
    y := 1;
  } else {
    skip
  }
} else {
  r2 :v= y;
  if (r2 = 0) {
    y := 1;
  } else {
    skip
  }
}
%% forbid ((3,7) ∉ .dp) []
