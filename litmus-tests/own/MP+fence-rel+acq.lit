// MP+fence-rel+acq -- message passing through a release fence and an acquire
// load.
//
// MoRDor's own test, for github #126: the mixed form of RC11's sw,
// [F_rel];po;[W];rf;[R_acq]. The relaxed flag write is po-after a release
// fence, which synchronises with the acquire load that reads it, so the data
// read must see the data write.
x := 0;
y := 0;
{
  x.store(1, rlx);
  fence(rel);
  y.store(1, rlx)
} ||| {
  r1 := y.load(acq);
  r2 := x.load(rlx)
}
%%
forbid (r1 = 1 && r2 = 0) [smrd]
forbid (r1 = 1 && r2 = 0) [rc11]
