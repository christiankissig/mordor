// Thread 1 writes z := 1 on every path: y is never written after its
// initialiser, so r2 = 1 and the then-arm's inner branch is always taken.
// sMRD allows r1 = 1.
//
// y is stored once, by its initialiser, which is ordered before both threads,
// so every read of y returns 1. MoRDor infers r2 = 1 as a de facto guarantee,
// and Weakening drops the guard r2 = 1. The then-arm's z := 1 is then
// justified under r1 = 1 alone, lifting it with the else-arm's under r1 != 1
// leaves z := 1 depending on nothing, and the cycle through x closes. The
// usual compiler transformation does the same: constant-fold y (LLVM's
// GlobalOpt) and hoist z := 1 above the read of x.
//
// Forwarding y := 1 into r2 := y used to give the same result, but forwarding
// no longer crosses a fork or a join. This asserted forbid until forwarding
// substituted into predicates (#46).
x := 0; y := 1; z := 0;
{
  r1 := x;
  if (r1 = 1) {
    r2 := y;
    if (r2 = 1) {
      z := 1
    }
  }
  else {
    z := 1;
  }
}|||{
  r3 := z;
  if (r3 = 1) {
    x := 1
  }
}
%%
allow (r1 = 1) []
