// Expected verdict from S. Chakraborty and V. Vafeiadis, "Grounding Thin-Air Reads with Event Structures", POPL 2019; checked here under IMM.
x := 0;
y := 0;
{
  r1 := x;
  if (r1 > 0) {
    y := 1
  } else {
    y := 1
  }
} ||| {
  r2 := y;
  if (r2 > 0) {
    x := 1
  }
}
%%
allow (r1 = 1 && r2 = 1) [IMM]