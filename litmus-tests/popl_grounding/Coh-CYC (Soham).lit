// Expected verdict from S. Chakraborty and V. Vafeiadis, "Grounding Thin-Air Reads with Event Structures", POPL 2019, §2.3 and Fig. 3: forbidden by weakestmo, allowed by weakest and by promising semantics (Example 2); checked here under sMRD.
x := 0;
y := 0;
{
   x := 2;
   r1 := x;
   if (r1 != 2) {
     y := 1;
   }
} ||| {
  x := 1;
  r2 := x;
  r3 := y;
  if(r3 != 0) {
    x := 3
  }
}
%%
forbid (r1 = 3 && r2 = 2 && r3 = 1) [sMRD] "Edge case."