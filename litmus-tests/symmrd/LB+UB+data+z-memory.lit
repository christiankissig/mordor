// LB+UB+data+z, asking about memory rather than registers. An execution that
// exploits the UB assumption writes 0 to z while r1 = 1, so z ends equal to
// rz. The final value of z has to be the one the execution wrote, not the
// structure's [z := r1] (github #65).
x := 0;
y := 0;
z := 0;
{
  r1 := x;
  y := 1 / !r1;
  z := r1;
  rz := z
}|||{
  r2 := y;
  x := r2;
}
%%
forbid (r1 != rz && z != rz) [UB11]
