// Expected verdict from J. Pichon-Pharabod and P. Sewell, "A Concurrency Semantics for Relaxed Atomics that Permits Optimisation and Avoids Thin-Air Executions", POPL 2016, Example 1 (§2.1, §6); checked here under sMRD.
x := 0;
y := 0;
{
  r1 := x;
  if (r1 = 42) {
    y := r1
  }
} ||| {
  r2 := y;
  if (r2 = 42) {
    x := 42
  } else {
    x := 42
  }
}
%%
allow (r1 = 42 && r2 = 42) [sMRD]