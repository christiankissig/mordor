x := 0;
y := 0;
z := 0;
{{
  x := 1;
  fence(sc);
  y := 1
} ||| {
  r1 := y;
  fence(sc);
  z := r1;
}} ||| {
  r2 := z;
  fence(sc);
  r3 := x
}
%%
// Noted with this test, source not recorded: Power allows this outcome. With fence(sc) mapped to sync,
// Power forbids it (ISA2+sync+sync).
forbid (r1 = 1 && r2 = 1 && r3 = 0) [Power]