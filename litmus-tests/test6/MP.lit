x := 0;
y := 0;
{
  x := 1;
  y.store(1, release);
} ||| {
  r1 := y.load(acquire);
  r2 := x
}
%%
// Noted with this test, source not recorded: Power allows this outcome. That holds for MP without
// barriers; with release/acquire mapped to lwsync and ctrl+isync, Power forbids it.
forbid (r1 = 1 && r2 = 0) [Power]