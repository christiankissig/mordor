// Expected verdict from A. Podkopaev, O. Lahav and V. Vafeiadis, "Bridging the Gap between Programming Languages and Hardware Weak Memory Models", POPL 2019; checked here under IMM.
// Section 3.1: Coherence; MP+rel+acq
x := 0;
y := 0;
{
  x := 1;
  y.store(1, rel)
} ||| {
  r1 := y.load(acq);
  r2 := x;
}
%%
forbid (r1 = 1 && r2 = 0) [IMM]