x.store(0, na);
y.store(0, na);
{{
  x.store(2, rlx)
} ||| {
  y.store(1, rlx);
  x.store(1, rel);
  x.store(3, rlx);
}} ||| {
  r1 := x.load(acquire);
  r2 := y.load(rlx)
}
%%
// C++20's release sequence (P0982) is the release store and the RMWs reading
// along it, so x.store(3, rlx) does not continue it and the acquire does not
// synchronise. RC11's, and sMRD's (#168), continue through later stores of the
// writer's thread, so the acquire synchronises and r2 = 0 is forbidden.
allow (r1=3 && r2=0) [C20]
forbid (r1=3 && r2=0) [RC11, sMRD]