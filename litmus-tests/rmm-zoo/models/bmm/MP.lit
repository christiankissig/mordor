// MP -- message passing over plain accesses, which TSO keeps in order.
//
// BMM, the buffered memory model for Java (Demange et al., POPL 2013): TSO,
// where a store and a later load stay in order when either is volatile.
// MoRDor writes a Java volatile as mode sc.
x := 0;
y := 0;
{
  x := 1;
  y := 1
} ||| {
  r1 := y;
  r2 := x
}
%%
forbid (r1 = 1 && r2 = 0) [BMM, TSO]
