// SB+rel+acq+fences -- with an SC fence between each store and load. The
// fences are ordered, so one thread's store happens before the other's load.
//
// CRC, the C11 fragment of Dodds, Batty & Gotsman (ESOP 2018): every atomic
// access release-acquire, non-atomic accesses with catch-fire semantics, and
// SC fences, totally ordered with each happening before the next.
x := 0;
y := 0;
{
  x.store(1, rel);
  fence(sc);
  r1 := y.load(acq)
} ||| {
  y.store(1, rel);
  fence(sc);
  r2 := x.load(acq)
}
%%
forbid (r1 = 0 && r2 = 0) [CRC]
