// MP+rel+acq -- release-acquire message passing.
//
// CRC, the C11 fragment of Dodds, Batty & Gotsman (ESOP 2018): every atomic
// access release-acquire, non-atomic accesses with catch-fire semantics, and
// SC fences, totally ordered with each happening before the next.
x := 0;
y := 0;
{
  x.store(1, rel);
  y.store(1, rel)
} ||| {
  r1 := y.load(acq);
  r2 := x.load(acq)
}
%%
forbid (r1 = 1 && r2 = 0) [CRC, RA]
