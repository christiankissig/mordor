// IRIW+vol+ra -- IRIW with volatile writes and release-acquire reads, the paper's Fig. 12a: the readers may disagree.
//
// Java Access Modes (Bender & Palsberg, OOPSLA 2019), the herd model of their
// Appendix A. Modes: na is plain, rlx opaque, acq/rel release-acquire, sc
// volatile. herd7 under a transcription of Appendix A answers Sometimes.
x := 0;
y := 0;
{
  x.store(1, sc)
} ||| {
  y.store(1, sc)
} ||| {
  r1 := x.load(acq);
  r2 := y.load(acq)
} ||| {
  r3 := y.load(acq);
  r4 := x.load(acq)
}
%%
allow (r1 = 1 && r2 = 0 && r3 = 1 && r4 = 0) [JAM]
