// Reordering (Load->Load) -- TRANSFORMED program.
//
// rmm-zoo property: reorder_ll (Reordering / sound).
// Source: as src.lit in this directory.
//
// The else-branch of src.lit has been reordered so that both branches agree.
x := 0;
y := 0;
z := 0;
r0 := z;
if (r0 = 1) {
  r1 := x;
  r2 := y
} else {
  r1 := x;
  r2 := y
}
