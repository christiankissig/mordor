// Reordering (Store->Load) -- SOURCE program.
//
// rmm-zoo property: reorder_sl (Reordering / sound).
// Source: Moiseenko, Podkopaev & Koznov, "A Survey of Programming Language
//         Memory Models" (2021), Tables 1-2 -- the Reordering group;
//         Sevcik, "Safe Optimisations for Shared-Memory Concurrent Programs"
//         (PLDI 2011) and his thesis, fig. 1.3, whose guarded shape this follows.
//
// The pair src.lit / opt.lit differ only in the else-branch, where the adjacent
// Store->Load pair has been swapped. The transformation is sound for a model
// exactly when the two programs have the same set of behaviours; compare with
//   dune exec mordor -- visual-es --single <file> --output-mode json
// run over both files, or read them off with `interpret --single`.
x := 0;
y := 0;
z := 0;
r0 := z;
if (r0 = 1) {
  x := 1;
  r1 := y
} else {
  r1 := y;
  x := 1
}
