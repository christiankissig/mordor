// Reordering (Load->Store) -- TRANSFORMED program.
//
// rmm-zoo property: reorder_ls (Reordering / sound).
// Source: as src.lit in this directory.
//
// The else-branch of src.lit has been reordered so that both branches agree.
x := 0;
y := 0;
z := 0;
r0 := z;
if (r0 = 1) {
  r1 := x;
  y := 1
} else {
  r1 := x;
  y := 1
}
