name=msqueue dequeue 1
%%
// Michael-Scott queue (Michael and Scott, "Simple, Fast, and Practical
// Non-Blocking and Blocking Concurrent Queue Algorithms", PODC 1996, Fig. 1),
// dequeue, with the C11 orderings of its usual ports: every load of head,
// tail or next that is followed is an acquire, and head and tail move by
// release CASes. A node is [value, next]; 0 is the null pointer. The queue
// holds one node behind the dummy, so the empty case is not taken. Nodes are
// not reclaimed, so the paper's modification counters, which guard its free
// list against ABA, are left out.
//
// Not episodic. The helping CAS of D10 advances tail when an enqueue has
// linked a node but not yet swung tail. The next iteration's D3 reads tail from
// it, which fails the write condition, and its D2 is an acquire read of head
// that nothing orders after D10's release write to tail, which fails the
// events condition. Without D10 the loop is episodic
// (msqueue_without_helping/dequeue.lit).

rdummy := malloc 2;
*rdummy := 0;
rn := malloc 2;
*rn := 1;
*(rn + 1) := 0;
*(rdummy + 1) := rn;

rhead := malloc 1;
*rhead := rdummy;
rtail := malloc 1;
*rtail := rn;

// --- dequeue ---
do {
  rdone := 0;
  rh :acq= *rhead;                          // D2
  rt :acq= *rtail;                          // D3
  rnext :acq= *(rh + 1);                    // D4
  rh2 :acq= *rhead;                         // D5
  if (rh = rh2) {
    if (rh = rt) {
      if (rnext != 0) {
        // D10: tail is lagging behind, advance it
        rhelped := cas(acquire, release, rtail, rt, rnext);
      }
    } else {
      // D11-D12: read the value before the CAS, then swing head
      rval := *rnext;
      rdone := cas(acquire, release, rhead, rh, rnext);
    }
  }
} while (rdone = 0);
