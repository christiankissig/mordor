name=rcu 1
%%
rN := 1;

rrcu := malloc rN;
*(rrcu + 0) := 0;

// The counter C is a global holding a pointer to the current node, which
// starts out as a node holding 0. fadd and cas act on C itself, through
// its address.
rinit := malloc 1;
*rinit := 0;
C := rinit;
rC := &C;

// inc
rtid := 0;
rn := malloc 1;
*(rrcu+rtid) := 1;
do {
  *(rrcu+rtid) := 0;
  *(rrcu+rtid) := 1;
  rs := fadd(acquire,release,rC,0);
  rv := *rs;
  *rn := rv+1;
  rsucc := cas(acquire,release,rC,rs,rn);
} while (rsucc = 0);
*(rrcu + rtid) := 0;   // leave the read-side critical section
