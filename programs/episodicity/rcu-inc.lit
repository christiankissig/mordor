name=rcu inc
%%
rN := 3;

rrcu := malloc rN;
*(rrcu + 0) := 0;
*(rrcu + 1) := 0;
*(rrcu + 2) := 0;

rC := malloc 1;
*rC := 0;

rtid := 0;
rn := malloc 1;
*(rrcu+rtid) := 1;
do {
  *(rrcu+rtid) := 0;
  *(rrcu+rtid) := 1;
  rs := fadd(acquire,release,rC,0);
  rv := *rs;
  *rn := rv+1;
  rsucc := cas(acquire,release,rC,rs,rn);
} while (rsucc = 0);
*(rrcu + rtid) := 0;
