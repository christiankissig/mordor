name=hp 1
%%
// global state
// C is a global holding a pointer to the current node, which starts out as a
// node holding 0. The protect loop reads C and the cas acts on it, through
// its address.
rinit := malloc 1;
*rinit := 0;
C := rinit;
rC := &C;

rhp := malloc 1;     // hp[N], N=1
*rhp := 0;

// --- inc ---
// I5
rn := malloc 1;
*rn := 0;

do {
  // I6-I10: protect. Publish a candidate, fence, and check C still holds it.
  // Folly's hazptr_holder reads C once above the loop and carries it in a
  // register; reading it at the top of the body is the same protocol without
  // the carried register, and without the branch a carry needs.
  do {
    rp := *rC;         // ptr = C.load(relaxed)
    *rhp := rp;        // I6/I9: reset_protection(ptr)
    fence(relacq);     // I8: separates the publish from the reload of C
    rrC := *rC         // p = C.load(acquire)
  } while (rrC != rp); // I10: retry with the new value

  // I11-I13
  rs := *rhp;
  rv := *rs;
  *rn := rv + 1;

  // I14
  rcas_succ := cas(acquire, release, rC, rs, rn);
} while (rcas_succ = 0);      // I15

*rhp := 0;   // I16: clear the hazard pointer
