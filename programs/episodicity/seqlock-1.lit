name=seqlock 1
%%
// C11 seqlock (Boehm, "Can seqlocks get along with programming language
// memory models?", MSPC 2012): the reader samples seq with an acquire load,
// reads the data relaxed, and separates the data read from the re-sample by an
// acquire fence. The writer orders its first bump before the data write by a
// release fence and publishes with a release store.

// Allocate the seqlock: seq counter + one data word
rseq  := malloc 1;
*rseq := 0;

rdata := malloc 1;
*rdata := 0;

// --- write ---
// Lock: bump seq to an odd value
rs := *rseq;
*rseq := rs + 1;
fence(release);

// Critical section: store new data
*rdata := 42;

// Unlock: bump seq to the next even value
*rseq :rel= rs + 2;

// --- read (retry loop) ---
do {
  // Sample seq before reading
  rr1 :acq= *rseq;

  // Read the data
  rval := *rdata;

  // Order the data read before the re-sample
  fence(acquire);

  // Sample seq after reading
  rr2 := *rseq;

  // Retry if seq changed or was odd (write in progress)
  rodd  := rr1 & 1;
  rdiff := rr1 ^ rr2;
  rretry := rodd | rdiff;
} while (rretry != 0);

// rval now holds a consistent snapshot of *rdata
