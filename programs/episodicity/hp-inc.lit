name=hp 1 inc
%%
rC  := malloc 1;
*rC := 0;

rhp := malloc 1;
*rhp := 0;

rn := malloc 1;
*rn := 0;

do {
  // protect: publish a candidate, fence, and check C still holds it.
  // Folly reads C once above the loop and carries it; reading it at the top
  // of the body is the same protocol without the carried register.
  do {
    rp   := *rC;        // ptr = C.load(relaxed)
    *rhp := rp;         // reset_protection(ptr)
    fence(relacq);      // separates the publish from the reload of C
    rrC  := *rC;        // p = C.load(acquire)
  } while (rrC != rp);  // retry with the new value

  rs := *rhp;
  rv := *rs;
  *rn := rv + 1;

  rcas_succ := cas(acquire, release, rC, rs, rn);
} while (rcas_succ = 0);

*rhp := 0;
