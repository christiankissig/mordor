name=hp 1 inc
%%
rC  := malloc 1;
*rC := 0;

rhp := malloc 1;
*rhp := 0;

rn := malloc 1;
*rn := 0;

do {
  *rhp := rC;

  do {
    rp := *rhp;
    fence(relacq);
    rrC := *rC;
    *rhp := rrC;
    rrhp := *rhp
  } while (rp != rrhp);

  rs := *rhp;
  rv := *rs;
  *rn := rv + 1;

  rcas_succ := cas(acquire, release, rC, rs, rn);
} while (rcas_succ = 0);

*rhp := 0;
